# Copie para .env, preencha voce mesmo e rode: chmod 600 .env
# O .env esta no .gitignore. Nao cole estes valores em chat, issue ou commit.

# Valor do cookie steamLoginSecure da sua sessao em steamcommunity.com
# (navegador logado: DevTools > Application > Cookies > https://steamcommunity.com).
# Ele deixa de valer quando voce sai da conta.
STEAM_LOGIN_SECURE=

# Opcional: cookie sessionid da mesma sessao.
STEAM_SESSIONID=

# Chave da API do IsThereAnyDeal (historico de preco dos jogos da loja).
# Crie uma conta, abra https://isthereanydeal.com/apps/my/ , clique em "Register App"
# e copie a "API Key" (nao o OAuth Client ID nem o Client Secret).
ITAD_API_KEY=
